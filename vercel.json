{
  "rewrites": [
    { "source": "/proposta-api/gerar-proposta", "destination": "/api/gerar-proposta" },
    { "source": "/proposta-api/interpretar-print", "destination": "/api/interpretar-print" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ]
}
